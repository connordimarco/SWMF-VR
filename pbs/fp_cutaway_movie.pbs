#!/bin/bash
# Athena (NASA HECC, PBS) version of the foot-point cutaway movie pipeline:
#   fls -> npz (if missing) -> seeds -> hybrid field lines -> cutaway frames -> mp4
# on ONE Turin node, NPAR pvbatch processes at a time (no job arrays on PBS; the
# scripts' own rank/size sharding and skip-if-done logic make it resumable).
#
# Submit from the repo root with .env set up for the run (SWMF_RUN_DIR, RBE_NPZ,
# SWMF_BASE_ISO, PV_BATCH, FFMPEG, PYTHON):
#   source slurm/env.sh
#   mkdir -p run/logs
#   qsub -o "$SWMF_VR_ROOT/run/logs/" -v NPAR=32 pbs/fp_cutaway_movie.pbs
# (PBS on Athena drops logs for a relative -o path; give it the absolute one.)
#PBS -S /bin/bash
#PBS -N swmfvr_cutaway
#PBS -W group_list=s3007
#PBS -l select=1:ncpus=256:model=tur_ath
#PBS -q normal
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -m be
#PBS -M cdimarco@umich.edu
set -uo pipefail

source /etc/profile >/dev/null 2>&1
cd "$PBS_O_WORKDIR"
source slurm/env.sh                      # .env -> SWMF_RUN_DIR, RBE_NPZ, PV_BATCH, ...
PYTHON="${PYTHON:-python3}"
FFMPEG="${FFMPEG:-ffmpeg}"
NPAR="${NPAR:-32}"
OUT_ROOT="${OUT_ROOT:-$SWMF_VR_ROOT/run}"
FRAME_DIR="${FRAME_DIR:-$OUT_ROOT/fp_cutaway_frames}"
MOVIE="${MOVIE:-$OUT_ROOT/fp_cutaway.mp4}"
FPS="${FPS:-8}"                          # 10-min frames: 8 fps = 80 min of storm per second
LOGS="$OUT_ROOT/logs"
mkdir -p "$OUT_ROOT" "$FRAME_DIR" "$LOGS"
export OMP_NUM_THREADS=2
echo "node $(hostname)  start $(date)  NPAR=$NPAR  run=$SWMF_RUN_DIR"

# 0. make preplot's .plt files readable by the VisIt Tecplot reader (resumable;
#    already-converted files are skipped, originals go to GM/IO2/preplot_orig/)
"$PYTHON" scripts/plt_visit_fix.py --in-place "$SWMF_RUN_DIR"/GM/IO2/*.plt > "$LOGS/plt_fix.log" 2>&1 \
    || { echo "plt header fix failed"; tail -5 "$LOGS/plt_fix.log"; exit 1; }

# 1. CIMI fls -> RBE-layout npz (frames with a 3D .plt only)
if [[ ! -f "$RBE_NPZ" ]]; then
    echo "[npz] $RBE_NPZ"
    "$PYTHON" scripts/cimi_fls_to_npz.py --fls-dir "$SWMF_RUN_DIR/IM/plots" \
        --plt-dir "$SWMF_RUN_DIR/GM/IO2" --base-iso "$SWMF_BASE_ISO" --out "$RBE_NPZ" \
        > "$LOGS/npz.log" 2>&1 || { echo "npz conversion failed"; tail -5 "$LOGS/npz.log"; exit 1; }
fi

# 2. belt boundaries in foot-point space (fast, serial)
echo "[seeds] $(date)"
"$PYTHON" scripts/footpoint_seeds.py 0 1 --out-root "$OUT_ROOT" > "$LOGS/seeds.log" 2>&1 \
    || { echo "seeds failed"; tail -5 "$LOGS/seeds.log"; exit 1; }
echo "[seeds] $(ls "$OUT_ROOT"/out_seeds_fp_outer/boundary_*.csv | wc -l) frames"

# 3. hybrid dipole + BATSRUS field lines, NPAR shards in parallel
echo "[trace] $(date)"
for ((r = 0; r < NPAR; r++)); do
    "$PV_BATCH" scripts/footpoint_trace.py "$r" "$NPAR" --out-root "$OUT_ROOT" \
        > "$LOGS/trace_${r}.log" 2>&1 &
done
wait
echo "[trace] $(ls "$OUT_ROOT"/obj_fp_outer/fieldlines_*.obj | wc -l) frames with outer OBJ"

# 4. cutaway render per frame (skip existing), NPAR at a time
echo "[cutaway] $(date)"
ls "$OUT_ROOT"/obj_fp_outer/fieldlines_*.obj | sed 's/.*fieldlines_//; s/\.obj//' | sort > "$LOGS/stamps.txt"
render_one() {
    local ts="$1" png="$FRAME_DIR/cutaway_$1.png"
    [[ -f "$png" ]] && return 0
    [[ -f "$OUT_ROOT/obj_fp_inner/fieldlines_${ts}.obj" ]] || { echo "no inner OBJ for $ts"; return 0; }
    "$PV_BATCH" scripts/fp_cutaway.py --ts "$ts" --out-root "$OUT_ROOT" --out "$png" \
        > "$LOGS/cutaway_${ts}.log" 2>&1 || echo "frame $ts failed"
}
export -f render_one
export PV_BATCH OUT_ROOT FRAME_DIR LOGS
xargs -P "$NPAR" -I{} bash -c 'render_one {}' < "$LOGS/stamps.txt"
echo "[cutaway] $(ls "$FRAME_DIR"/cutaway_*.png 2>/dev/null | wc -l) frames rendered"

# 5. stitch
echo "[movie] $(date)"
"$FFMPEG" -y -framerate "$FPS" -pattern_type glob -i "$FRAME_DIR/cutaway_*.png" \
    -c:v libx264 -pix_fmt yuv420p -vf "scale=trunc(iw/2)*2:trunc(ih/2)*2" "$MOVIE" \
    > "$LOGS/ffmpeg.log" 2>&1 && ls -la "$MOVIE"
"$FFMPEG" -y -i "$MOVIE" -vf scale=1280:-2 -c:v libx264 -pix_fmt yuv420p "${MOVIE%.mp4}_720p.mp4" \
    >> "$LOGS/ffmpeg.log" 2>&1 && ls -la "${MOVIE%.mp4}_720p.mp4"
echo "done $(date)"
