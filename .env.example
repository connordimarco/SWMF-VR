# SWMF-VR machine config. Copy to .env and fill in for your setup:
#   cp .env.example .env && $EDITOR .env && source slurm/env.sh
# .env is gitignored (keep your real paths/account out of git); this template is committed.

# --- data ---
export SWMF_RUN_DIR=/path/to/swmf/run                   # SWMF run dir (has GM/IO2/*.plt + logs)
export CIMI_NPZ=/path/to/cimi_flux.npz                  # the CIMI flux NPZ
export PV_BATCH=/path/to/ParaView-osmesa/bin/pvbatch    # ParaView OSMesa pvbatch

# --- SLURM (sbatch auto-applies SBATCH_ACCOUNT / SBATCH_PARTITION) ---
export SBATCH_ACCOUNT=your_slurm_account
export SBATCH_PARTITION=standard
export SWMFVR_MAIL=                                      # your email for job notices (blank = none)
